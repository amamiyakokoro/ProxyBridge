#include <winver.h>
#include "pb_version.h"
#include "pb_build_revision.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PB_VERSION_NUMBERS
 PRODUCTVERSION PB_VERSION_NUMBERS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRIVATEBUILD
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "KokoroBox contributors"
            VALUE "FileDescription", "KokoroBox application routing core"
            VALUE "FileVersion", PB_VERSION_STRING
            VALUE "InternalName", "ProxyBridgeCore"
            VALUE "OriginalFilename", "ProxyBridgeCore.dll"
            VALUE "ProductName", "ProxyBridge for KokoroBox"
            VALUE "ProductVersion", PB_VERSION_STRING
            VALUE "PrivateBuild", PB_SOURCE_REVISION
            VALUE "LegalCopyright", "Copyright (c) 2025 Anof-cyber/InterceptSuite; Copyright (c) 2026 PhoenixEmik"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
