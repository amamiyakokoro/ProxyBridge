// KokoroBox-specific overrides for the existing system-extension target.
// Signing values are supplied by KokoroBox's isolated release pipeline.

PRODUCT_NAME = KokoroBoxProxyExtension
PRODUCT_BUNDLE_IDENTIFIER = com.amamiyakokoro.app.proxy-extension
PRODUCT_MODULE_NAME = KokoroBoxProxyExtension
INFOPLIST_FILE = extension/Info.KokoroBox.plist
GENERATE_INFOPLIST_FILE = YES
CODE_SIGN_ENTITLEMENTS = extension/KokoroBox.entitlements
MACOSX_DEPLOYMENT_TARGET = 13.0
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
ARCHS = $(KOKOROBOX_TARGET_ARCH)
ONLY_ACTIVE_ARCH = YES
